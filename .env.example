DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/budget_system
JWT_SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
VITE_ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=false
ALLOW_PLACEHOLDER_PASSWORDS=true
ALLOWED_EMAIL_DOMAINS=sit.edu.sg,example.com,test.com
SMTP_USER=example@gmail.com
SMTP_PASS=email_password
SMTP_HOST=smtp.gmail.com

# Ask AI (OpenAI). Backend only - never expose as VITE_*.
# Leave LLM_API_KEY blank to run Ask AI on the built-in template answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Ask AI retrieval embeddings (W13-03A). Backend only.
# Leave EMBEDDING_PROVIDER blank to answer from the SQL fact sheet alone.
#   local: free, in-process (pip install fastembed); model downloads on first use
#   api:   any OpenAI-compatible /embeddings API, needs EMBEDDING_API_KEY
#          OpenAI: EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small
# Changing provider or model means re-indexing knowledge_chunks.
# Needs backend/migrations/add_rag_knowledge.sql (and pgvector) on the DB.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Optional relevance cutoff (cosine distance); defaults per model. Measure with
#   python -m app.scripts.probe_knowledge "question" ...
EMBEDDING_MAX_DISTANCE=
