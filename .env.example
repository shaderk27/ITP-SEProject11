DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/budget_system
JWT_SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
VITE_ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=false
ALLOW_PLACEHOLDER_PASSWORDS=true
ALLOWED_EMAIL_DOMAINS=sit.edu.sg,example.com,test.com
SMTP_USER=example@gmail.com
SMTP_PASS=email_password
SMTP_HOST=smtp.gmail.com

# Ask AI (OpenRouter). Backend only - never expose as VITE_*.
# Leave blank to run Ask AI on the built-in template answers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
