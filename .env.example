DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/budget_system
JWT_SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
VITE_ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=false
ALLOW_PLACEHOLDER_PASSWORDS=true
ALLOWED_EMAIL_DOMAINS=sit.edu.sg,example.com,test.com
SMTP_USER=example@gmail.com
SMTP_PASS=email_password
SMTP_HOST=smtp.gmail.com

# Ask AI. Backend only - never expose as VITE_*.
# Any OpenAI-compatible provider; switching is just these three lines.
# Leave LLM_API_KEY blank to run Ask AI on the built-in template answers.
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=google/gemini-2.5-flash-lite
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
# TODO(client-handover): OpenRouter is interim. The OpenRouter line above and
# the OpenRouter values below will be removed before final submission to the
# client (defaults become https://api.openai.com/v1 and gpt-4o-mini).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash-lite
